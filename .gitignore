            board[i][j] = EMPTY;
}
void print_board() {
    printf("\n   ");
    for (int i = 0; i < BOARD_SIZE; i++)
        printf("%2d ", i + 1);
    printf("\n");

    for (int i = 0; i < BOARD_SIZE; i++) {
        printf("%2d ", i + 1);
        for (int j = 0; j < BOARD_SIZE; j++) {
            if (board[i][j] == EMPTY) printf(" . ");
            else if (board[i][j] == BLACK) printf(" X ");
            else printf(" O ");
        }
        printf("\n");
    }
    printf("\n");}
